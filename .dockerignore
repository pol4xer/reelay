# Only send the files consumed by Dockerfile to the Docker build context.
# In particular, migration bundles, .env, queues, and local secrets stay outside it.
**
!Dockerfile
!pyproject.toml
!uv.lock
!reelay/
!reelay/**
!assets/
!assets/reelay-telegram-avatar.png

# Also exclude local artifacts accidentally created inside the Python package.
**/.env
**/.env.*
**/secrets/**
**/credentials/**
**/*credentials*.json
**/client_secret*.json
**/*token*.json
**/cookies*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.mobileprovision
**/data/**
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/__pycache__/**
**/*.py[cod]
**/.venv/**
**/.ruff_cache/**
**/.pytest_cache/**
**/.mypy_cache/**
**/.DS_Store
**/._*
**/.vscode/**
**/.idea/**
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.tar.xz
**/*.7z
**/*.bak
**/*.backup
